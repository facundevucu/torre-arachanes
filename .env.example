# ── Bot ──────────────────────────────────────────────────────────────────────
# Número del padre en formato JID de WAHA (ej: 5491123456789@c.us)
# Un número o varios separados por coma (ej: 59891234567@c.us,59892345678@c.us)
AUTHORIZED_NUMBER=59891234567@c.us

# Identificador @lid alternativo del mismo número (WhatsApp Business/Meta linked accounts).
# Algunos mensajes llegan con este formato en vez de @c.us. Obtenerlo del log de "Ignored message from".
# Dejar vacío si no aplica.
AUTHORIZED_LID=

# JID del grupo de vecinos (obtenido via GET /api/default/chats)
GROUP_JID=120363XXXXXXXXXXX@g.us

# Token secreto compartido entre WAHA y el backend (generá uno con: openssl rand -hex 32)
WEBHOOK_SECRET=cambia_esto

# ── Claude ───────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ── Google Sheets (gastos comunes) ───────────────────────────────────────────
# ID de la hoja de cálculo (parte de la URL: /spreadsheets/d/<SHEET_ID>/edit)
SHEET_ID=

# GIDs de las pestañas a exportar, separados por coma (ver URL: ...#gid=<GID>).
# Dejar vacío para exportar todo el documento en una sola request.
SHEET_GIDS=

# Ruta al JSON de credenciales de la cuenta de servicio de Google Cloud.
# El archivo debe estar fuera del repositorio y montado en el contenedor.
GOOGLE_CREDENTIALS_PATH=/app/credentials.json

# ── WAHA ─────────────────────────────────────────────────────────────────────
WAHA_API_KEY=cambia_esto
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambia_esto
WHATSAPP_DEFAULT_ENGINE=NOWEB

# URL del backend que WAHA llama para los webhooks (usa el nombre del servicio Docker)
WHATSAPP_HOOK_URL=http://backend:8000/webhook
# Token que WAHA incluye como header X-Hook-Token (debe coincidir con WEBHOOK_SECRET)
WHATSAPP_HOOK_TOKEN=cambia_esto
